# Copy to .env for local development. Never commit .env.
PRUFLO_ENV=local
# Local database password, used by docker-compose.yml and the app.
# Generate one with: openssl rand -hex 16
PRUFLO_DB_PASSWORD=
PRUFLO_GCP_PROJECT=pruflo-local
# Firebase project whose sign-in tokens are accepted (see Docs/deployment.md).
PRUFLO_FIREBASE_PROJECT=
# Locally there are no admin credentials for the Firebase project, so skip the
# revocation check (tokens are still verified). Keep it on everywhere else.
PRUFLO_FIREBASE_CHECK_REVOKED=false
PRUFLO_REGION=asia-southeast1
PRUFLO_EVIDENCE_BUCKET=pruflo-evidence-local
PRUFLO_PUBSUB_TOPIC=evidence-jobs
# Local only: accept "Bearer dev:<uid>:<email>" instead of a Firebase token.
PRUFLO_AUTH_DEV_MODE=true
PUBSUB_EMULATOR_HOST=localhost:8085
STORAGE_EMULATOR_HOST=http://localhost:4443
# "local" keeps uploads on disk and serves them from this API; "gcs" on Cloud Run.
PRUFLO_STORAGE_BACKEND=local
PRUFLO_PUBLIC_BASE_URL=http://localhost:8000
# "inline" runs processing in the API process right after an upload (local).
# Cloud Run uses "pubsub" with the separate worker service.
PRUFLO_QUEUE_BACKEND=inline
# Optional: Document AI OCR for scans and images. Without it, scans are marked
# needs_review. A location outside asia-southeast1 needs sign-off first.
PRUFLO_DOCUMENTAI_LOCATION=
PRUFLO_DOCUMENTAI_PROCESSOR_ID=
# Encrypts webhook signing secrets at rest. Optional locally (derived from the
# database password); required elsewhere. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRUFLO_SECRETS_KEY=
# Optional document sources (Integrations > Sources). Each is offered once set.
# Email inbox: inbound mail domain, the token the mail service sends, and its
# Authentication-Results name.
PRUFLO_INBOUND_EMAIL_DOMAIN=
PRUFLO_INBOUND_EMAIL_TOKEN=
PRUFLO_INBOUND_AUTHSERV_ID=
# Google Drive and SharePoint OAuth apps; redirect URI:
# <PRUFLO_PUBLIC_BASE_URL>/v1/connectors/oauth/callback
PRUFLO_GOOGLE_OAUTH_CLIENT_ID=
PRUFLO_GOOGLE_OAUTH_CLIENT_SECRET=
PRUFLO_MICROSOFT_OAUTH_CLIENT_ID=
PRUFLO_MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional: migrations as a separate role (python -m app.cli db-roles).
# Empty: migrations use the same connection as the app.
PRUFLO_MIGRATION_DATABASE_URL=
# Gemini on Vertex AI reads documents (needs Vertex AI access). Off: the
# structured reader handles labelled fields and line-item tables.
PRUFLO_GEMINI_ENABLED=false
PRUFLO_GEMINI_EXPLANATIONS=false
# Retention in days (0 keeps everything until a period is agreed).
PRUFLO_EVIDENCE_RETENTION_DAYS=0
PRUFLO_REPORT_RETENTION_DAYS=0
# Free deployment (Docs/fix_plan.md): files in Firestore, the Firebase key
# from the environment, and the scheduled-work endpoint.
# PRUFLO_STORAGE_BACKEND=firestore
# PRUFLO_STORAGE_SIGNING_KEY=
# PRUFLO_FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
# PRUFLO_GEMINI_API_KEY=
# PRUFLO_TICK_TOKEN=
